{
  "id": "claw-onshape",
  "name": "Claw-Onshape",
  "version": "0.3.0-rc.1",
  "description": "Scoped Onshape REST reads and separate OAuth/MCP foundations",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "cliCommands": [
    {
      "name": "onshape",
      "description": "Manage Onshape connections",
      "hasSubcommands": true
    }
  ],
  "contracts": {
    "tools": [
      "onshape_inspect",
      "onshape_status",
      "onshape_render",
      "onshape_delegate_render",
      "onshape_verify_feature_read",
      "onshape_delegate_inspect",
      "onshape_delegate_task",
      "onshape_complete_task",
      "onshape_propose_update",
      "onshape_mutation_context",
      "onshape_reconcile_update",
      "onshape_goal_propose",
      "onshape_goal_status",
      "onshape_goal_reconcile",
      "onshape_goal_verify",
      "onshape_goal_stop"
    ]
  },
  "toolMetadata": {
    "onshape_inspect": {
      "optional": true
    },
    "onshape_status": {
      "optional": true
    },
    "onshape_render": {
      "optional": true
    },
    "onshape_delegate_render": {
      "optional": true
    },
    "onshape_verify_feature_read": {
      "optional": true
    },
    "onshape_delegate_inspect": {
      "optional": true
    },
    "onshape_delegate_task": {
      "optional": true
    },
    "onshape_complete_task": {
      "optional": true
    },
    "onshape_propose_update": {
      "optional": true
    },
    "onshape_mutation_context": {
      "optional": true
    },
    "onshape_reconcile_update": {
      "optional": true
    },
    "onshape_goal_propose": {
      "optional": true
    },
    "onshape_goal_status": {
      "optional": true
    },
    "onshape_goal_reconcile": {
      "optional": true
    },
    "onshape_goal_verify": {
      "optional": true
    },
    "onshape_goal_stop": {
      "optional": true
    }
  },
  "uiHints": {
    "bindings": {
      "label": "Authorized user, agent and Onshape context",
      "help": "Exact trusted sender/channel/account bindings. Empty disables all tools."
    },
    "liveReads": {
      "label": "Enable authorized REST reads",
      "help": "Defaults off. Enable only after operator authorization."
    },
    "oauth.clientId": {
      "label": "Your registered Onshape OAuth client ID"
    },
    "oauth.clientSecretFile": {
      "label": "Private OAuth application secret file",
      "help": "Absolute path provisioned by the operator; never put the secret value here."
    },
    "oauth.dashboardRedirectUri": {
      "label": "Registered dashboard OAuth callback",
      "help": "Operator registers the exact loopback Control UI origin and /plugins/claw-onshape/oauth/callback path."
    },
    "engineerAgentId": {
      "label": "Mechanical Engineer agent ID"
    },
    "delegation.keyFile": {
      "label": "Private delegation signing key file",
      "help": "Clawake-provisioned shared private HMAC key; never the key value."
    },
    "delegation.transportTokenFile": {
      "label": "Private A2A transport token file",
      "help": "Optional; existing A2A_LEAD_TO_MECHANICAL environment is used otherwise."
    },
    "bindings.*.elementId": {
      "label": "Authorized Camera Mount Plate Part Studio"
    },
    "oauth.applicationPermissions": {
      "label": "Onshape application permission attestations",
      "help": "Record verified settings only. Omitted means unknown; keep unused permissions disabled."
    },
    "goals.enabled": {
      "label": "Enable goal-scoped authorization",
      "help": "Defaults off. Requires an onshape-mcp server that lists goal-grant-v1."
    },
    "goals.approvalDirectory": {
      "label": "Goal grant directory",
      "help": "Absolute private directory shared with onshape-mcp; goal-grant.json is written next to approved-update.json."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["bindings"],
    "properties": {
      "liveReads": {
        "type": "boolean",
        "default": false
      },
      "oauth": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientId", "clientSecretFile"],
        "properties": {
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "clientSecretFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/[^\\u0000-\\u001f]+$"
          },
          "dashboardRedirectUri": {
            "type": "string",
            "maxLength": 256
          },
          "applicationPermissions": {
            "type": "object",
            "additionalProperties": false,
            "description": "Trusted operator attestations of Onshape application settings. Omitted fields mean unknown; these settings grant no rights.",
            "properties": {
              "canReadDocuments": {
                "type": "boolean"
              },
              "canWriteDocuments": {
                "type": "boolean"
              },
              "canDeleteDocumentsAndWorkspaces": {
                "type": "boolean"
              },
              "canRequestPurchases": {
                "type": "boolean"
              },
              "canShareAndUnshareDocuments": {
                "type": "boolean"
              },
              "canReadProfileInformation": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "bindings": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agentId",
            "requesterSenderId",
            "messageChannel",
            "agentAccountId",
            "connectionRef",
            "documentId",
            "primaryWorkspaceId",
            "workspaceId"
          ],
          "properties": {
            "agentId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "requesterSenderId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "messageChannel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "agentAccountId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "connectionRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "documentId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "primaryWorkspaceId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "workspaceId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "elementId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "discordChannelId": {
              "type": "string",
              "pattern": "^[0-9]{16,22}$"
            }
          }
        }
      },
      "engineerAgentId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "delegation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leadAgentId", "engineerAgentId", "peerSenderId", "accountId", "keyFile"],
        "properties": {
          "leadAgentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "engineerAgentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "peerSenderId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "accountId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "keyFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/"
          },
          "transportTokenFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/"
          }
        }
      },
      "localMcp": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connectionRef", "credentialDirectory"],
        "properties": {
          "connectionRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "credentialDirectory": {
            "type": "string",
            "pattern": "^/"
          }
        }
      },
      "goals": {
        "type": "object",
        "additionalProperties": false,
        "description": "Goal-scoped mutation authorization (goal-workflow.md §10). Off by default.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "approvalDirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/[^\\u0000-\\u001f]+$"
          }
        }
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/product/index.js"
  }
}
